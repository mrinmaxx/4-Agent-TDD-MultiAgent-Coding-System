# Copy this file to `.env` and fill in your own values. `.env` is gitignored.

# Active model (provider/model). Examples:
#   groq/llama-3.1-8b-instant   groq/llama-3.3-70b-versatile
#   gemini/gemini-2.5-flash     openai/gpt-4o-mini
MSWEA_MODEL_NAME=groq/llama-3.1-8b-instant

# API keys — only the one matching your active model's provider is required.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: give just the Implementer a different model (defaults to MSWEA_MODEL_NAME)
# MULTISWE_IMPLEMENTER_MODEL=gemini/gemini-2.5-flash
